generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
  DAMAGED
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  resetTokenHash String?
  resetExpiresAt DateTime?
  passwordHash   String
  role           Role            @default(STAFF)
  orders         Order[]
  sales          Sale[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Supplier {
  id            String    @id @default(uuid())
  name          String    @unique
  company       String?
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("suppliers")
}

model Product {
  id                String          @id @default(uuid())
  sku               String          @unique
  name              String
  imageUrl          String? @db.LongText
  description       String?
  price             Float
  costPrice         Float
  stockQuantity     Int             @default(0)
  lowStockThreshold Int             @default(10)
  categoryId        String?
  category          Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplierId        String?
  supplier          Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  orderItems        OrderItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("products")
}

model Order {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  totalAmount   Float
  discount      Float         @default(0.0)
  netAmount     Float
  paymentMethod PaymentMethod @default(CASH)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
  createdAt DateTime @default(now())

  @@map("order_items")
}

model Sale {
  id            String     @id @default(uuid())
  invoiceNumber String     @unique
  totalAmount   Float
  discount      Float      @default(0.0)
  netAmount     Float
  status        SaleStatus @default(COMPLETED)
  paymentMethod PaymentMethod @default(CASH)
  taxRate       Float @default(0)
  taxAmount     Float @default(0)
  customerId    String?
  customerName  String?
  customerPhone String?
  notes         String?
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  items         SaleItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("sales")
}

model SaleItem {
  id        String   @id @default(uuid())
  costRecorded Boolean @default(false)
  costPrice Float @default(0)
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float
  subtotal  Float
  createdAt DateTime @default(now())

  @@map("sale_items")
}

model StockMovement {
  id        String            @id @default(uuid())
  type      StockMovementType
  quantity  Int
  reason    String?
  productId String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  createdAt DateTime          @default(now())

  @@map("stock_movements")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}
model Purchase {
  id String @id @default(uuid())
  invoiceNumber String @unique
  supplierId String
  supplierName String
  status String @default("PENDING")
  paymentStatus String @default("UNPAID")
  purchaseDate DateTime @default(now())
  totalAmount Float
  userId String
  items PurchaseItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PurchaseItem {
  id String @id @default(uuid())
  purchaseId String
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId String
  productName String
  quantity Int
  unitCost Float
  subtotal Float
}
model Setting {
  id String @id @default("store")
  value Json
}
model Activity {
  id String @id @default(uuid())
  userId String
  userName String
  action String
  entityId String?
  createdAt DateTime @default(now())
}
